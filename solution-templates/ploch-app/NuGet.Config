<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <packageSources>
        <clear />
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
        <add key="github" value="https://nuget.pkg.github.com/mrploch/index.json" />
    </packageSources>
    <!--
        Central Package Management requires every source to be mapped. Public packages come from
        nuget.org; the MrPloch GitHub Packages feed serves any Ploch.* packages consumed as NuGet
        (this template uses sibling ProjectReferences by default, so the github feed is only needed
        if you switch to PackageReferences).
    -->
    <packageSourceMapping>
        <packageSource key="nuget.org">
            <package pattern="*" />
        </packageSource>
        <packageSource key="github">
            <package pattern="Ploch.*" />
        </packageSource>
    </packageSourceMapping>
    <packageSourceCredentials>
        <github>
            <add key="Username" value="mrploch" />
            <add key="ClearTextPassword" value="%MRPLOCH_GITHUB_PACKAGES_TOKEN%" />
        </github>
    </packageSourceCredentials>
    <disabledPackageSources />
</configuration>
